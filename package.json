{
  "name": "codeforces-workbench",
  "displayName": "Codeforces Workbench",
  "description": "Import Codeforces contests and problems, write solutions, run tests, and track submissions in VS Code.",
  "version": "0.1.0",
  "publisher": "acstride",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/acstride-labs/codeforces-workbench.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:.codeforces-workbench/workspace.json",
    "workspaceContains:.codeforces-workbench/contests.json",
    "workspaceContains:.codeforces-workbench/standalone.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%trust.description%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codeforcesWorkbench.openSettings",
        "title": "%command.codeforcesWorkbench.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "codeforcesWorkbench.openContestCenter",
        "title": "%command.codeforcesWorkbench.openContestCenter%",
        "icon": {
          "light": "resources/icons/trophy-light.svg",
          "dark": "resources/icons/trophy-dark.svg"
        }
      },
      {
        "command": "codeforcesWorkbench.addContest",
        "title": "%command.codeforcesWorkbench.addContest%",
        "icon": "$(add)"
      },
      {
        "command": "codeforcesWorkbench.switchLanguage",
        "title": "%command.codeforcesWorkbench.switchLanguage%",
        "icon": "$(code)"
      },
      {
        "command": "codeforcesWorkbench.createProblem",
        "title": "%command.codeforcesWorkbench.createProblem%",
        "icon": "$(add)"
      },
      {
        "command": "codeforcesWorkbench.openProblem",
        "title": "%command.codeforcesWorkbench.openProblem%"
      },
      {
        "command": "codeforcesWorkbench.runTests",
        "title": "%command.codeforcesWorkbench.runTests%"
      },
      {
        "command": "codeforcesWorkbench.stop",
        "title": "%command.codeforcesWorkbench.stop%"
      },
      {
        "command": "codeforcesWorkbench.refresh",
        "title": "%command.codeforcesWorkbench.refresh%"
      },
      {
        "command": "codeforcesWorkbench.submitSolution",
        "title": "%command.codeforcesWorkbench.submitSolution%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codeforcesWorkbench.signIn",
        "title": "%command.codeforcesWorkbench.signIn%"
      },
      {
        "command": "codeforcesWorkbench.signOut",
        "title": "%command.codeforcesWorkbench.signOut%"
      },
      {
        "command": "codeforcesWorkbench.addCodeforcesProblem",
        "title": "%command.codeforcesWorkbench.addCodeforcesProblem%",
        "icon": "$(add)"
      },
      {
        "command": "codeforcesWorkbench.openCodeforcesProblem",
        "title": "%command.codeforcesWorkbench.openCodeforcesProblem%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeforcesWorkbench",
          "title": "AC-Stride",
          "icon": "resources/icons/codeforces-workbench.svg"
        }
      ]
    },
    "views": {
      "codeforcesWorkbench": [
        {
          "id": "codeforcesWorkbench.contests",
          "name": "%view.contests%",
          "canToggleVisibility": true
        },
        {
          "id": "codeforcesWorkbench.codeforcesProblems",
          "name": "%view.codeforcesProblems%",
          "canToggleVisibility": true
        },
        {
          "id": "codeforcesWorkbench.problems",
          "name": "%view.practice%",
          "canToggleVisibility": true
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "codeforcesWorkbench.switchLanguage",
          "when": "codeforcesWorkbench.sourceActive",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "codeforcesWorkbench.addContest",
          "when": "view == codeforcesWorkbench.contests",
          "group": "navigation@1"
        },
        {
          "command": "codeforcesWorkbench.addCodeforcesProblem",
          "when": "view == codeforcesWorkbench.codeforcesProblems",
          "group": "navigation@1"
        },
        {
          "command": "codeforcesWorkbench.createProblem",
          "when": "view == codeforcesWorkbench.problems",
          "group": "navigation@1"
        },
        {
          "command": "codeforcesWorkbench.openSettings",
          "when": "view == codeforcesWorkbench.contests",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeforcesWorkbench.runTests",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == cpp || editorLangId == python"
      }
    ],
    "configuration": {
      "title": "AC-Stride",
      "properties": {
        "codeforcesWorkbench.ui.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN",
            "ru",
            "ja"
          ],
          "enumDescriptions": [
            "%language.auto%",
            "English",
            "\u7b80\u4f53\u4e2d\u6587",
            "\u0420\u0443\u0441\u0441\u043a\u0438\u0439",
            "\u65e5\u672c\u8a9e"
          ],
          "default": "auto",
          "scope": "application",
          "description": "%setting.codeforcesWorkbench.ui.language%",
          "order": -1000,
          "markdownDescription": "%setting.codeforcesWorkbench.ui.language.markdown%"
        },
        "codeforcesWorkbench.codeforces.handle": {
          "type": "string",
          "default": "",
          "description": "%setting.codeforcesWorkbench.codeforces.handle%"
        },
        "codeforcesWorkbench.python.interpreter": {
          "type": "string",
          "default": "python3",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.python.interpreter%"
        },
        "codeforcesWorkbench.python.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.codeforcesWorkbench.python.args%"
        },
        "codeforcesWorkbench.python.templatePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.python.templatePath%"
        },
        "codeforcesWorkbench.python.templateCode": {
          "type": "string",
          "default": "",
          "maxLength": 1000000,
          "description": "%setting.codeforcesWorkbench.python.templateCode%"
        },
        "codeforcesWorkbench.cpp.templateCode": {
          "type": "string",
          "default": "",
          "maxLength": 1000000,
          "description": "%setting.codeforcesWorkbench.cpp.templateCode%"
        },
        "codeforcesWorkbench.cpp.compiler": {
          "type": "string",
          "default": "g++",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.cpp.compiler%"
        },
        "codeforcesWorkbench.cpp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-std=c++20",
            "-O2",
            "-Wall",
            "-Wextra"
          ],
          "description": "%setting.codeforcesWorkbench.cpp.args%"
        },
        "codeforcesWorkbench.run.timeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 60000,
          "description": "%setting.codeforcesWorkbench.run.timeoutMs%"
        },
        "codeforcesWorkbench.cpp.templatePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.cpp.templatePath%"
        },
        "codeforcesWorkbench.solution.defaultLanguage": {
          "type": "string",
          "enum": [
            "cpp",
            "python",
            "java",
            "kotlin"
          ],
          "default": "cpp",
          "description": "%setting.codeforcesWorkbench.solution.defaultLanguage%"
        },
        "codeforcesWorkbench.java.compiler": {
          "type": "string",
          "default": "javac",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.java.compiler%"
        },
        "codeforcesWorkbench.java.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.codeforcesWorkbench.java.args%"
        },
        "codeforcesWorkbench.java.runtime": {
          "type": "string",
          "default": "java",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.java.runtime%"
        },
        "codeforcesWorkbench.java.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.codeforcesWorkbench.java.runtimeArgs%"
        },
        "codeforcesWorkbench.java.templatePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.java.templatePath%"
        },
        "codeforcesWorkbench.java.templateCode": {
          "type": "string",
          "default": "",
          "maxLength": 1000000,
          "description": "%setting.codeforcesWorkbench.java.templateCode%"
        },
        "codeforcesWorkbench.kotlin.compiler": {
          "type": "string",
          "default": "kotlinc",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.kotlin.compiler%"
        },
        "codeforcesWorkbench.kotlin.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.codeforcesWorkbench.kotlin.args%"
        },
        "codeforcesWorkbench.kotlin.runtime": {
          "type": "string",
          "default": "java",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.kotlin.runtime%"
        },
        "codeforcesWorkbench.kotlin.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.codeforcesWorkbench.kotlin.runtimeArgs%"
        },
        "codeforcesWorkbench.kotlin.templatePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codeforcesWorkbench.kotlin.templatePath%"
        },
        "codeforcesWorkbench.kotlin.templateCode": {
          "type": "string",
          "default": "",
          "maxLength": 1000000,
          "description": "%setting.codeforcesWorkbench.kotlin.templateCode%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-localization.mjs && node esbuild.mjs && vite build",
    "build:downloader": "node scripts/build-downloader.mjs",
    "build:codeforces-client": "node scripts/build-codeforces-client.mjs",
    "verify:codeforces-client": "node scripts/verify-codeforces-client.mjs",
    "verify:downloader": "node scripts/verify-downloader.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:release && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.mjs",
    "test:release": "node --test test/release-policy.test.mjs"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "cheerio": "^1.2.0",
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yauzl": "^3.4.0"
  },
  "icon": "resources/icons/marketplace.png",
  "homepage": "https://acstride.com/en",
  "bugs": {
    "url": "https://github.com/acstride-labs/codeforces-workbench/issues"
  },
  "keywords": [
    "codeforces",
    "competitive programming",
    "algorithm",
    "testing",
    "contest"
  ]
}
