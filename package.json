{
  "name": "cfide",
  "displayName": "AC-Stride",
  "description": "Codeforces workbench: automatic problem downloads, C++/Python tests, confirmed submission and official verdict notifications.",
  "version": "0.14.2",
  "publisher": "cfide-dev",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/acstride-labs/acstride-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:.cfide/workspace.json",
    "workspaceContains:.cfide/contests.json",
    "workspaceContains:.cfide/standalone.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%trust.description%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "cfide.openSettings",
        "title": "%command.cfide.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "cfide.openContestCenter",
        "title": "%command.cfide.openContestCenter%",
        "icon": {
          "light": "resources/icons/trophy-light.svg",
          "dark": "resources/icons/trophy-dark.svg"
        }
      },
      {
        "command": "cfide.addContest",
        "title": "%command.cfide.addContest%",
        "icon": "$(add)"
      },
      {
        "command": "cfide.switchLanguage",
        "title": "%command.cfide.switchLanguage%",
        "icon": "$(code)"
      },
      {
        "command": "cfide.createProblem",
        "title": "%command.cfide.createProblem%",
        "icon": "$(add)"
      },
      {
        "command": "cfide.openProblem",
        "title": "%command.cfide.openProblem%"
      },
      {
        "command": "cfide.runTests",
        "title": "%command.cfide.runTests%"
      },
      {
        "command": "cfide.stop",
        "title": "%command.cfide.stop%"
      },
      {
        "command": "cfide.refresh",
        "title": "%command.cfide.refresh%"
      },
      {
        "command": "cfide.submitSolution",
        "title": "%command.cfide.submitSolution%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "cfide.signIn",
        "title": "%command.cfide.signIn%"
      },
      {
        "command": "cfide.signOut",
        "title": "%command.cfide.signOut%"
      },
      {
        "command": "cfide.addCodeforcesProblem",
        "title": "%command.cfide.addCodeforcesProblem%",
        "icon": "$(add)"
      },
      {
        "command": "cfide.openCodeforcesProblem",
        "title": "%command.cfide.openCodeforcesProblem%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cfide",
          "title": "AC-Stride",
          "icon": "resources/icons/cfide.svg"
        }
      ]
    },
    "views": {
      "cfide": [
        {
          "id": "cfide.contests",
          "name": "%view.contests%",
          "canToggleVisibility": true
        },
        {
          "id": "cfide.codeforcesProblems",
          "name": "%view.codeforcesProblems%",
          "canToggleVisibility": true
        },
        {
          "id": "cfide.problems",
          "name": "%view.practice%",
          "canToggleVisibility": true
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "cfide.switchLanguage",
          "when": "cfide.sourceActive",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "cfide.addContest",
          "when": "view == cfide.contests",
          "group": "navigation@1"
        },
        {
          "command": "cfide.addCodeforcesProblem",
          "when": "view == cfide.codeforcesProblems",
          "group": "navigation@1"
        },
        {
          "command": "cfide.createProblem",
          "when": "view == cfide.problems",
          "group": "navigation@1"
        },
        {
          "command": "cfide.openSettings",
          "when": "view == cfide.contests",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cfide.runTests",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == cpp || editorLangId == python"
      }
    ],
    "configuration": {
      "title": "AC-Stride",
      "properties": {
        "cfide.ui.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN",
            "ru",
            "ja"
          ],
          "enumDescriptions": [
            "%language.auto%",
            "English",
            "简体中文",
            "Русский",
            "日本語"
          ],
          "default": "auto",
          "scope": "application",
          "description": "%setting.cfide.ui.language%",
          "order": -1000,
          "markdownDescription": "%setting.cfide.ui.language.markdown%"
        },
        "cfide.codeforces.handle": {
          "type": "string",
          "default": "",
          "description": "%setting.cfide.codeforces.handle%"
        },
        "cfide.python.interpreter": {
          "type": "string",
          "default": "python3",
          "scope": "machine-overridable",
          "description": "%setting.cfide.python.interpreter%"
        },
        "cfide.python.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.cfide.python.args%"
        },
        "cfide.python.templatePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.cfide.python.templatePath%"
        },
        "cfide.python.templateCode": {
          "type": "string",
          "default": "",
          "maxLength": 1000000,
          "description": "%setting.cfide.python.templateCode%"
        },
        "cfide.cpp.templateCode": {
          "type": "string",
          "default": "",
          "maxLength": 1000000,
          "description": "%setting.cfide.cpp.templateCode%"
        },
        "cfide.cpp.compiler": {
          "type": "string",
          "default": "g++",
          "scope": "machine-overridable",
          "description": "%setting.cfide.cpp.compiler%"
        },
        "cfide.cpp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-std=c++20",
            "-O2",
            "-Wall",
            "-Wextra"
          ],
          "description": "%setting.cfide.cpp.args%"
        },
        "cfide.run.timeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 60000,
          "description": "%setting.cfide.run.timeoutMs%"
        },
        "cfide.cpp.templatePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.cfide.cpp.templatePath%"
        },
        "cfide.solution.defaultLanguage": {
          "type": "string",
          "enum": [
            "cpp",
            "python"
          ],
          "default": "cpp",
          "description": "%setting.cfide.solution.defaultLanguage%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-localization.mjs && node esbuild.mjs && vite build",
    "build:downloader": "node scripts/build-downloader.mjs",
    "build:cf-tool": "node scripts/build-cf-tool.mjs",
    "verify:cf-tool": "node scripts/verify-cf-tool.mjs",
    "verify:downloader": "node scripts/verify-downloader.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yauzl": "^3.4.0"
  }
}
